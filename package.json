{
  "name": "markdown-live-editor",
  "version": "0.3.0",
  "description": "A cross-platform markdown editor with live preview and image hosting",
  "main": "out/main/index.js",
  "author": "you",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "electron-vite build && set ELECTRON_BUILDER_BINARIES_DOWNLOAD_OVERRIDE_URL=https://registry.npmmirror.com/-/binary/electron-builder-binaries/&& electron-builder --win --x64 --ia32 --config",
    "build:mac": "electron-vite build && electron-builder --mac --config",
    "build:linux": "electron-vite build && electron-builder --linux --config",
    "build:all": "electron-vite build && set ELECTRON_BUILDER_BINARIES_DOWNLOAD_OVERRIDE_URL=https://registry.npmmirror.com/-/binary/electron-builder-binaries/&& electron-builder --win --x64 --ia32 --mac --linux --config",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.2.5",
    "@codemirror/language": "^6.10.2",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.28.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@lezer/highlight": "^1.2.0",
    "@vscode/markdown-it-katex": "^1.1.0",
    "codemirror": "^6.0.1",
    "dompurify": "^3.1.6",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.1.7",
    "highlight.js": "^11.10.0",
    "html-to-docx": "^1.8.0",
    "katex": "^0.16.10",
    "markdown-it": "^14.1.0",
    "markdown-it-highlightjs": "^4.0.1",
    "markdown-it-imsize": "^2.0.1",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^10.9.1",
    "picgo": "^2.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
